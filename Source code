package skillup;

import java.sql.*;
import java.time.LocalDate;
import java.time.LocalTime;
import java.util.Scanner;

// ABSTRACTION AND ENCAPSULATION
abstract class User {
    private int userId;
    private String name;
    private String email;
    private String bio;

    public User(int userId, String name, String email, String bio) {
        this.userId = userId;
        this.name = name;
        this.email = email;
        this.bio = bio;
    }

    public int getUserId() {
        return userId;
    }

    public String getName() {
        return name;
    }

    public String getEmail() {
        return email;
    }

    public String getBio() {
        return bio;
    }

    public void setBio(String bio) {
        this.bio = bio;
    }

    public abstract String getRole();
}

// INHERITANCE AND POLYMORPHISM
class Learner extends User {
    public Learner(int id, String name, String email, String bio) {
        super(id, name, email, bio);
    }

    @Override
    public String getRole() {
        return "LEARNER";
    }
}

class Teacher extends User {
    public Teacher(int id, String name, String email, String bio) {
        super(id, name, email, bio);
    }

    @Override
    public String getRole() {
        return "TEACHER";
    }
}

// CUSTOM EXCEPTION
class SkillupException extends Exception {
    public SkillupException(String message) {
        super(message);
    }
}

